{
    "name": "Lightbox",
    "description": "Low-nonsense reader extension",
    "version": "0.1",
    "manifest_version": 3,
    "action": {},
    "permissions": ["activeTab", "scripting", "storage", "webNavigation"],
    "background": {
        "service_worker": "src/background.ts"
    },
    "web_accessible_resources": [
        {
            "resources": ["src/reader/base.html"],
            "matches": ["<all_urls>"]
        }
    ]
}
